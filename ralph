#!/usr/bin/env bash
#
# ralph -- run a coding agent in autonomous ("yolo") mode inside a locked-down
# container: deny-by-default egress, no host filesystem beyond one workspace,
# no access to the host Docker daemon.
#
# https://github.com/jmanzo/ralph-sandbox
#
set -euo pipefail

# ---------------------------------------------------------------------------
# Locate the repo, following symlinks so `ralph` works from anywhere on $PATH.
# ---------------------------------------------------------------------------
_self="${BASH_SOURCE[0]}"
while [ -L "$_self" ]; do
  _dir="$(cd -P "$(dirname "$_self")" && pwd)"
  _self="$(readlink "$_self")"
  [[ "$_self" != /* ]] && _self="$_dir/$_self"
done
RALPH_ROOT="$(cd -P "$(dirname "$_self")" && pwd)"

# ---------------------------------------------------------------------------
# Config. Every value is overridable by env var, or in the config file.
# ---------------------------------------------------------------------------
_cfg_home="${XDG_CONFIG_HOME:-$HOME/.config}/ralph"
_data_home="${XDG_DATA_HOME:-$HOME/.local/share}/ralph"
RALPH_CONFIG="${RALPH_CONFIG:-$_cfg_home/config.env}"
# shellcheck disable=SC1090
[ -f "$RALPH_CONFIG" ] && . "$RALPH_CONFIG"

RALPH_IMAGE="${RALPH_IMAGE:-ralph-sandbox}"
RALPH_PROXY_IMAGE="${RALPH_PROXY_IMAGE:-ralph-proxy}"
RALPH_HOME_VOLUME="${RALPH_HOME_VOLUME:-ralph-home}"
RALPH_WORKSPACE="${RALPH_WORKSPACE:-$PWD}"
RALPH_AGENT_CMD_SET="${RALPH_AGENT_CMD+1}"
RALPH_AGENT_CMD="${RALPH_AGENT_CMD:-claude --dangerously-skip-permissions}"

# Which provider drives the loop, and which one catches it when the first runs
# out of road. Anthropic is the default and runs the four-role tree; OpenAI's
# codex is the fallback and runs one session playing all four parts, because
# Codex has no per-role subagent definitions. RALPH_FALLBACK=off keeps a run
# single-provider.
RALPH_PROVIDER="${RALPH_PROVIDER:-anthropic}"
RALPH_FALLBACK="${RALPH_FALLBACK:-codex}"
RALPH_CODEX_CMD="${RALPH_CODEX_CMD:-codex exec}"
RALPH_CODEX_AGENT_CMD="${RALPH_CODEX_AGENT_CMD:-codex --dangerously-bypass-approvals-and-sandbox}"
# One model for the whole codex session, so this is the seat the architect and
# developer work demands, not the cheap routing seat. gpt-5.6-terra and
# gpt-5.6-luna are the cheaper rungs; gpt-6-astra is the expensive one.
RALPH_CODEX_MODEL="${RALPH_CODEX_MODEL:-gpt-5.6-sol}"
RALPH_CODEX_EFFORT="${RALPH_CODEX_EFFORT:-high}"
# What a spent usage limit looks like in a transcript. Only consulted on an
# iteration that already failed.
RALPH_LIMIT_PATTERN="${RALPH_LIMIT_PATTERN:-}"

# The Ralph loop: how many iterations `ralph loop` runs without an argument,
# and when it gives up on an agent that is failing or going in circles.
# 0 = no cap: run until the PRD is done or a guardrail trips.
RALPH_LOOP_MAX="${RALPH_LOOP_MAX:-0}"
# Optional spend ceiling for uncapped runs, e.g. RALPH_LOOP_MAX_COST=25
RALPH_LOOP_MAX_COST="${RALPH_LOOP_MAX_COST:-}"
RALPH_LOOP_SLEEP="${RALPH_LOOP_SLEEP:-0}"
RALPH_LOOP_STALL="${RALPH_LOOP_STALL:-3}"
RALPH_LOOP_FAILS="${RALPH_LOOP_FAILS:-2}"
# Halt when the orchestrator reports the same failure this many iterations
# running. Two agents trading one bug back and forth is the most expensive way
# for an unattended loop to achieve nothing.
RALPH_LOOP_REPEAT="${RALPH_LOOP_REPEAT:-3}"

# The orchestrator routes and records; the subagents think. Its model is set
# here because it is the session `ralph loop` starts. The other three live in
# the project's .claude/agents/*.md -- see `ralph model`.
RALPH_MODEL_ORCHESTRATOR="${RALPH_MODEL_ORCHESTRATOR:-haiku}"

# Where to send the end-of-run notification. Configure any or all; each one
# that is set gets a copy. All of them are posted from the HOST, after the
# container exits, so no webhook URL or bot token ever reaches the sandbox and
# the egress allowlist stays as tight as it was.
RALPH_SLACK_WEBHOOK="${RALPH_SLACK_WEBHOOK:-}"
RALPH_DISCORD_WEBHOOK="${RALPH_DISCORD_WEBHOOK:-}"
RALPH_TELEGRAM_TOKEN="${RALPH_TELEGRAM_TOKEN:-}"
RALPH_TELEGRAM_CHAT="${RALPH_TELEGRAM_CHAT:-}"
# Overridable so a proxy or a self-hosted Bot API server can be used.
RALPH_TELEGRAM_API="${RALPH_TELEGRAM_API:-https://api.telegram.org}"
# always  -- notify however the run ended, success included
# problem -- only when it ended badly (error, stuck, stalled, ceiling hit)
RALPH_NOTIFY_ON="${RALPH_NOTIFY_ON:-always}"

# Workspace isolation, mirroring Docker Sandboxes:
#   direct -- host workspace bind-mounted read-write (live, and destructible)
#   clone  -- host workspace read-only, agent works in a private copy
#   none   -- no host filesystem at all
RALPH_MODE="${RALPH_MODE:-direct}"

# Deny-by-default egress through the proxy sidecar.
RALPH_NETWORK_POLICY="${RALPH_NETWORK_POLICY:-on}"
RALPH_ALLOWLIST="${RALPH_ALLOWLIST:-$_cfg_home/allowlist}"
RALPH_INTERNAL_NET="${RALPH_INTERNAL_NET:-ralph-internal}"
RALPH_EGRESS_NET="${RALPH_EGRESS_NET:-ralph-egress}"
RALPH_PROXY_NAME="${RALPH_PROXY_NAME:-ralph-proxy}"

# Host-side snapshots, so direct mode is recoverable.
RALPH_SNAPSHOT="${RALPH_SNAPSHOT:-on}"
RALPH_SNAPSHOT_DIR="${RALPH_SNAPSHOT_DIR:-$_data_home/snapshots}"
RALPH_SNAPSHOT_KEEP="${RALPH_SNAPSHOT_KEEP:-10}"

# Blast-radius limits.
RALPH_MEMORY="${RALPH_MEMORY:-}"
RALPH_CPUS="${RALPH_CPUS:-}"
RALPH_PIDS_LIMIT="${RALPH_PIDS_LIMIT:-2048}"
# on = drop all capabilities and forbid privilege escalation. This also makes
# `sudo` stop working, so package installs inside the sandbox will fail.
RALPH_HARDEN="${RALPH_HARDEN:-off}"

RALPH_MOUNT_GITCONFIG="${RALPH_MOUNT_GITCONFIG:-1}"
RALPH_MOUNT_SSH="${RALPH_MOUNT_SSH:-0}"
RALPH_DOCKER_ARGS="${RALPH_DOCKER_ARGS:-}"

die()  { printf 'ralph: %s\n' "$*" >&2; exit 1; }
info() { printf '\033[2m==> %s\033[0m\n' "$*" >&2; }
warn() { printf '\033[33mralph: %s\033[0m\n' "$*" >&2; }

command -v docker >/dev/null 2>&1 || die "docker not found on PATH"

image_exists()  { docker image inspect  "$1" >/dev/null 2>&1; }
volume_exists() { docker volume inspect "$1" >/dev/null 2>&1; }
net_exists()    { docker network inspect "$1" >/dev/null 2>&1; }
proxy_running() { [ "$(docker inspect -f '{{.State.Running}}' "$RALPH_PROXY_NAME" 2>/dev/null)" = "true" ]; }

# The command `ralph run` hands the terminal to, which depends on who is
# driving. An explicit RALPH_AGENT_CMD still wins, as it always has: choosing
# a provider must not silently discard a command someone asked for by name.
provider_agent_cmd() {
  case "$1" in
    codex) [ -n "$RALPH_AGENT_CMD_SET" ] \
             && printf '%s' "$RALPH_AGENT_CMD" \
             || printf '%s' "$RALPH_CODEX_AGENT_CMD" ;;
    *)     printf '%s' "$RALPH_AGENT_CMD" ;;
  esac
}

check_provider() {
  case "$1" in
    anthropic|claude) printf 'anthropic' ;;
    codex|openai)     printf 'codex' ;;
    *) die "unknown provider '$1' (expected anthropic or codex)" ;;
  esac
}

# --provider, wherever it appears in a command's arguments. Consumed here so it
# never reaches the agent.
take_provider_flag() {
  RALPH_ARGV=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --provider)   [ $# -ge 2 ] || die "--provider needs a value"
                    RALPH_PROVIDER="$(check_provider "$2")"; shift 2 ;;
      --provider=*) RALPH_PROVIDER="$(check_provider "${1#*=}")"; shift ;;
      *) RALPH_ARGV+=("$1"); shift ;;
    esac
  done
}

# The codex fallback is useless if the egress policy predates it. Check before
# a run rather than discovering it during the handover, when nobody is watching.
allowlist_allows() {
  local host="$1" rule
  while IFS= read -r rule; do
    printf '%s\n' "$host" | grep -qE -- "$rule" 2>/dev/null && return 0
  done < <(grep -vE '^[[:space:]]*(#|$)' "$RALPH_ALLOWLIST")
  return 1
}

warn_codex_egress() {
  local turn_host
  [ "$RALPH_NETWORK_POLICY" = "on" ] || return 0
  [ -f "$RALPH_ALLOWLIST" ] || return 0
  if [ -n "${OPENAI_API_KEY:-}" ]; then
    turn_host=api.openai.com
  else
    turn_host=chatgpt.com
  fi
  allowlist_allows "$turn_host" && return 0
  warn "the egress policy does not allow $turn_host, so codex cannot reach its API"
  warn "run 'ralph policy sync' to add them without losing your own rules"
}

# Does the proxy actually answer on the internal network? The proxy image is
# Alpine, so busybox nc is already there and this costs almost nothing.
proxy_reachable() {
  docker run --rm --network "$RALPH_INTERNAL_NET" \
    --entrypoint sh "$RALPH_PROXY_IMAGE" -c 'nc -z -w 3 proxy 8888' >/dev/null 2>&1
}

# A stable per-project identifier, used to name per-workspace volumes and to
# file snapshots.
project_id() {
  printf '%s' "$RALPH_WORKSPACE" | cksum | awk '{print $1}'
}
project_slug() {
  printf '%s-%s' "$(basename "$RALPH_WORKSPACE" | tr -c 'a-zA-Z0-9_.-' '-')" "$(project_id)"
}
ws_volume_name() {
  case "$RALPH_MODE" in
    none) printf 'ralph-box-%s' "$(project_slug)" ;;
    *)    printf 'ralph-ws-%s'  "$(project_slug)" ;;
  esac
}

# ---------------------------------------------------------------------------
# Egress policy
# ---------------------------------------------------------------------------
ensure_allowlist() {
  if [ ! -f "$RALPH_ALLOWLIST" ]; then
    mkdir -p "$(dirname "$RALPH_ALLOWLIST")"
    cp "$RALPH_ROOT/policy/default.allowlist" "$RALPH_ALLOWLIST"
    info "seeded egress policy at $RALPH_ALLOWLIST"
  fi
}

proxy_up() {
  ensure_allowlist
  image_exists "$RALPH_PROXY_IMAGE" || build_proxy

  net_exists "$RALPH_INTERNAL_NET" || docker network create --internal "$RALPH_INTERNAL_NET" >/dev/null
  net_exists "$RALPH_EGRESS_NET"   || docker network create "$RALPH_EGRESS_NET" >/dev/null

  if proxy_running; then return 0; fi
  docker rm -f "$RALPH_PROXY_NAME" >/dev/null 2>&1 || true

  info "starting egress proxy (deny-by-default)"
  # create -> connect -> start. Attaching the second network to an already
  # running container races against Docker setting up its network sandbox.
  docker create --name "$RALPH_PROXY_NAME" \
    --network "$RALPH_INTERNAL_NET" --network-alias proxy \
    --restart unless-stopped \
    -v "$RALPH_ALLOWLIST:/etc/tinyproxy/allowlist:ro" \
    "$RALPH_PROXY_IMAGE" >/dev/null
  docker network connect "$RALPH_EGRESS_NET" "$RALPH_PROXY_NAME"
  docker start "$RALPH_PROXY_NAME" >/dev/null

  # Fail loudly rather than silently running without a policy. Checking
  # .State.Running is not enough: with a restart policy, a crash-looping
  # container flickers through "running" between attempts. Probe the port.
  local tries=0
  until proxy_reachable; do
    tries=$((tries + 1))
    if [ "$tries" -gt 10 ]; then
      docker logs --tail 20 "$RALPH_PROXY_NAME" >&2 || true
      die "egress proxy is not accepting connections (see log above)"
    fi
    sleep 0.5
  done
}

proxy_down() {
  if docker rm -f "$RALPH_PROXY_NAME" >/dev/null 2>&1; then
    info "egress proxy stopped"
  else
    info "egress proxy not running"
  fi
}

cmd_policy() {
  case "${1:-ls}" in
    ls)
      ensure_allowlist
      printf 'policy file: %s\n\n' "$RALPH_ALLOWLIST"
      grep -vE '^\s*(#|$)' "$RALPH_ALLOWLIST" || true
      ;;
    path)  ensure_allowlist; printf '%s\n' "$RALPH_ALLOWLIST" ;;
    edit)
      ensure_allowlist
      "${EDITOR:-vi}" "$RALPH_ALLOWLIST"
      proxy_running && { info "restarting proxy to apply policy"; docker restart "$RALPH_PROXY_NAME" >/dev/null; }
      ;;
    reset)
      mkdir -p "$(dirname "$RALPH_ALLOWLIST")"
      cp "$RALPH_ROOT/policy/default.allowlist" "$RALPH_ALLOWLIST"
      info "policy reset to defaults"
      proxy_running && docker restart "$RALPH_PROXY_NAME" >/dev/null
      ;;
    sync)
      # An allowlist is seeded once and then belongs to the user, so shipping a
      # new default does not reach an existing install. That is usually right,
      # and exactly wrong for a host a new feature needs: the codex fallback
      # would fail at the far end of an unattended run. This adds what is
      # missing and touches nothing that is already there.
      ensure_allowlist
      local added=0 rule
      while IFS= read -r rule; do
        [ -n "$rule" ] || continue
        grep -qxF "$rule" "$RALPH_ALLOWLIST" && continue
        [ "$added" -eq 0 ] && printf '\n# --- added by ralph policy sync on %s ---\n' \
          "$(date -u +%Y-%m-%d)" >> "$RALPH_ALLOWLIST"
        printf '%s\n' "$rule" >> "$RALPH_ALLOWLIST"
        info "added $rule"
        added=$((added + 1))
      done < <(grep -vE '^\s*(#|$)' "$RALPH_ROOT/policy/default.allowlist")
      if [ "$added" -eq 0 ]; then
        info "policy already has every shipped rule"
      else
        info "$added rule(s) added to $RALPH_ALLOWLIST"
        proxy_running && { info "restarting proxy to apply policy"; docker restart "$RALPH_PROXY_NAME" >/dev/null; }
      fi
      ;;
    test)
      local host="${2:-}"
      [ -n "$host" ] || die "usage: ralph policy test <hostname>"
      proxy_up
      docker run --rm --network "$RALPH_INTERNAL_NET" \
        -e https_proxy="http://proxy:8888" "$RALPH_IMAGE" \
        curl -s -o /dev/null -w "%{http_code}\n" --max-time 15 "https://$host" \
        | { read -r code
            if [ "$code" = "000" ]; then printf '%s: BLOCKED by policy\n' "$host"
            else printf '%s: allowed (HTTP %s)\n' "$host" "$code"; fi; }
      ;;
    *) die "usage: ralph policy <ls|path|edit|sync|reset|test HOST>" ;;
  esac
}

# ---------------------------------------------------------------------------
# Snapshots (host side, so the agent cannot reach them)
# ---------------------------------------------------------------------------
snapshot_store() { printf '%s/%s' "$RALPH_SNAPSHOT_DIR" "$(project_slug)"; }

cmd_snapshot() {
  case "${1:-create}" in
    create) snapshot_create ;;
    ls)
      local store; store="$(snapshot_store)"
      [ -d "$store" ] || { info "no snapshots for this workspace"; return 0; }
      printf 'snapshots for %s\n\n' "$RALPH_WORKSPACE"
      find "$store" -maxdepth 1 -name '*.bundle' 2>/dev/null | sort -r | while read -r b; do
        printf '  %s  (%s)\n' "$(basename "$b" .bundle)" "$(du -h "$b" | awk '{print $1}')"
      done
      ;;
    restore) snapshot_restore "${2:-}" ;;
    *) die "usage: ralph snapshot <create|ls|restore [ID]>" ;;
  esac
}

snapshot_create() {
  [ "$RALPH_SNAPSHOT" = "on" ] || return 0
  git -C "$RALPH_WORKSPACE" rev-parse --git-dir >/dev/null 2>&1 || {
    [ "${1:-}" = "quiet" ] || warn "workspace is not a git repo -- no snapshot taken"
    return 0
  }
  git -C "$RALPH_WORKSPACE" rev-parse HEAD >/dev/null 2>&1 || {
    [ "${1:-}" = "quiet" ] || warn "repo has no commits yet -- no snapshot taken"
    return 0
  }

  local store ts tree commit idx
  store="$(snapshot_store)"; mkdir -p "$store"
  ts="$(date +%Y%m%d-%H%M%S)"
  idx="$(mktemp -t ralph-idx.XXXXXX)"; rm -f "$idx"

  # Build the snapshot in a throwaway index so the user's staged changes and
  # `git status` are left exactly as they were.
  (
    export GIT_INDEX_FILE="$idx"
    git -C "$RALPH_WORKSPACE" read-tree HEAD
    git -C "$RALPH_WORKSPACE" add -A
  )
  tree="$(GIT_INDEX_FILE="$idx" git -C "$RALPH_WORKSPACE" write-tree)"
  rm -f "$idx"
  commit="$(git -C "$RALPH_WORKSPACE" commit-tree "$tree" -p HEAD \
              -m "ralph snapshot $ts")"
  git -C "$RALPH_WORKSPACE" update-ref "refs/ralph/snapshots/$ts" "$commit"

  # The ref alone lives in .git, which the agent can delete. The bundle is
  # written outside the mount, where the sandbox has no reach.
  git -C "$RALPH_WORKSPACE" bundle create "$store/$ts.bundle" \
      --all "refs/ralph/snapshots/$ts" >/dev/null 2>&1 \
    || git -C "$RALPH_WORKSPACE" bundle create "$store/$ts.bundle" "$commit" >/dev/null 2>&1

  # Keep the store bounded.
  find "$store" -maxdepth 1 -name '*.bundle' 2>/dev/null | sort -r \
    | tail -n "+$((RALPH_SNAPSHOT_KEEP + 1))" | while read -r old; do
    rm -f "$old"
  done
  info "snapshot $ts"
}

snapshot_restore() {
  local id="$1" store bundle
  store="$(snapshot_store)"
  [ -d "$store" ] || die "no snapshots for this workspace"
  if [ -z "$id" ]; then
    bundle="$(find "$store" -maxdepth 1 -name '*.bundle' 2>/dev/null | sort -r | head -1)"
    [ -n "$bundle" ] || die "no snapshots for this workspace"
    id="$(basename "$bundle" .bundle)"
  else
    bundle="$store/$id.bundle"
  fi
  [ -f "$bundle" ] || die "no such snapshot: $id"

  # The agent may have deleted .git outright -- that is the case this whole
  # mechanism exists for, so rebuild a repo around the bundle rather than
  # giving up.
  if ! git -C "$RALPH_WORKSPACE" rev-parse --git-dir >/dev/null 2>&1; then
    warn ".git is missing -- reinitialising the repository from the snapshot"
    git -C "$RALPH_WORKSPACE" init -q
  fi

  warn "restoring snapshot $id over $RALPH_WORKSPACE"
  printf 'This overwrites current files. Continue? [y/N] ' >&2
  read -r reply
  case "$reply" in [yY]*) ;; *) die "aborted" ;; esac

  # Fetch into a staging namespace first: git refuses to fetch directly into
  # the branch that is currently checked out.
  git -C "$RALPH_WORKSPACE" fetch -q "$bundle" \
    '+refs/heads/*:refs/ralph/restored-heads/*' \
    "+refs/ralph/snapshots/$id:refs/ralph/restored/$id"

  # update-ref has no such restriction, so branches can be put back in place.
  git -C "$RALPH_WORKSPACE" for-each-ref --format='%(refname) %(objectname)' \
      refs/ralph/restored-heads \
    | while read -r ref sha; do
        git -C "$RALPH_WORKSPACE" update-ref \
          "refs/heads/${ref#refs/ralph/restored-heads/}" "$sha"
      done
  git -C "$RALPH_WORKSPACE" for-each-ref --format='%(refname)' refs/ralph/restored-heads \
    | while read -r ref; do git -C "$RALPH_WORKSPACE" update-ref -d "$ref"; done

  # Put the files back, then unstage, so uncommitted work reappears as
  # uncommitted work rather than as a staged blob.
  git -C "$RALPH_WORKSPACE" checkout -q "refs/ralph/restored/$id" -- .
  git -C "$RALPH_WORKSPACE" reset -q

  info "restored snapshot $id"
  info "working tree and history are back; review with: git status && git log"
}

# ---------------------------------------------------------------------------
# Build
# ---------------------------------------------------------------------------
build_proxy() {
  info "building $RALPH_PROXY_IMAGE"
  # policy/default.allowlist is the single source of truth; stage a copy into
  # the proxy build context so the two cannot drift.
  cp "$RALPH_ROOT/policy/default.allowlist" "$RALPH_ROOT/proxy/default.allowlist"
  docker build -t "$RALPH_PROXY_IMAGE" "$RALPH_ROOT/proxy"
}

# In direct mode the host workspace is bind-mounted, and on Linux a bind mount
# keeps the host's real uid. A sandbox user that doesn't match it cannot write
# to the workspace it was given -- the agent dies on its first commit with
# "Permission denied". So the image is built with the invoking user's ids.
#
# Docker Desktop virtualises bind-mount ownership, so macOS hosts don't have
# the problem and stay on the image default. That keeps the common case
# reproducible, and confines a host-specific image to the hosts that need one.
build_uid_args() {
  [ "$(uname -s)" = "Linux" ] || return 0
  printf '%s\n' --build-arg "SANDBOX_UID=$(id -u)" --build-arg "SANDBOX_GID=$(id -g)"
}

# The home volume holds the agent's login and is created on first run, owned by
# whatever uid the image had then. Rebuilding under a different uid leaves it
# unwritable, which looks like a broken login rather than a stale volume.
warn_stale_home() {
  [ "$(uname -s)" = "Linux" ] || return 0
  volume_exists "$RALPH_HOME_VOLUME" || return 0
  local owner
  owner="$(docker run --rm -v "$RALPH_HOME_VOLUME:/h" --entrypoint stat "$RALPH_IMAGE" \
             -c '%u' /h 2>/dev/null)" || return 0
  [ -n "$owner" ] && [ "$owner" != "$(id -u)" ] || return 0
  warn "$RALPH_HOME_VOLUME is owned by uid $owner but the sandbox now runs as $(id -u)"
  warn "the agent will not be able to write its login -- run: ralph clean volume"
}

cmd_build() {
  info "building $RALPH_IMAGE"
  local uid_args=() ; while IFS= read -r a; do uid_args+=("$a"); done < <(build_uid_args)
  docker build ${uid_args[@]+"${uid_args[@]}"} "$@" -t "$RALPH_IMAGE" "$RALPH_ROOT"
  build_proxy
  warn_stale_home
}

cmd_update() {
  info "rebuilding from scratch with the latest agents (claude and codex)"
  local uid_args=() ; while IFS= read -r a; do uid_args+=("$a"); done < <(build_uid_args)
  docker build --pull --no-cache ${uid_args[@]+"${uid_args[@]}"} "$@" -t "$RALPH_IMAGE" "$RALPH_ROOT"
  cp "$RALPH_ROOT/policy/default.allowlist" "$RALPH_ROOT/proxy/default.allowlist"
  docker build --pull --no-cache -t "$RALPH_PROXY_IMAGE" "$RALPH_ROOT/proxy"
  proxy_running && docker restart "$RALPH_PROXY_NAME" >/dev/null
  warn_stale_home
  return 0
}

# ---------------------------------------------------------------------------
# Run
# ---------------------------------------------------------------------------
cmd_run() {
  local entry=()
  case "${RALPH_ENTRY:-agent}" in
    shell) entry=(/bin/bash) ;;
    loop)  entry=(ralph-loop) ;;
    login) entry=(bash -lc "${RALPH_LOGIN_CMD:-true}") ;;
    *)     read -r -a entry <<<"$(provider_agent_cmd "$RALPH_PROVIDER")" ;;
  esac

  image_exists "$RALPH_IMAGE" || { info "no image yet, building (one time)"; cmd_build; }
  volume_exists "$RALPH_HOME_VOLUME" || docker volume create "$RALPH_HOME_VOLUME" >/dev/null

  local args=()

  # --- workspace mode -----------------------------------------------------
  # Clone and mountless workspaces are different things; keep them apart.
  local ws_volume
  ws_volume="$(ws_volume_name)"
  case "$RALPH_MODE" in
    direct)
      [ -d "$RALPH_WORKSPACE" ] || die "workspace not a directory: $RALPH_WORKSPACE"
      snapshot_create quiet
      args+=(-v "$RALPH_WORKSPACE:/workspace")
      ;;
    clone)
      [ -d "$RALPH_WORKSPACE" ] || die "workspace not a directory: $RALPH_WORKSPACE"
      volume_exists "$ws_volume" || docker volume create "$ws_volume" >/dev/null
      args+=(-v "$RALPH_WORKSPACE:/run/sandbox/source:ro" -v "$ws_volume:/workspace")
      ;;
    none)
      volume_exists "$ws_volume" || docker volume create "$ws_volume" >/dev/null
      args+=(-v "$ws_volume:/workspace")
      ;;
    *) die "unknown RALPH_MODE: $RALPH_MODE (expected direct, clone or none)" ;;
  esac

  args+=(-v "$RALPH_HOME_VOLUME:/home/sandboxuser")

  # The image bakes in a copy of the loop driver, but mount the repo's over it
  # so the driver always matches the `ralph` that launched it. Editing loop.sh
  # otherwise needs a rebuild to take effect, and the failure is silent: an old
  # driver runs and quietly lacks the newer guardrails. Read-only, so the agent
  # cannot rewrite its own supervisor.
  if [ "${RALPH_ENTRY:-agent}" = "loop" ] && [ -f "$RALPH_ROOT/loop.sh" ]; then
    args+=(-v "$RALPH_ROOT/loop.sh:/usr/local/bin/ralph-loop:ro")
  fi

  # --- network policy -----------------------------------------------------
  if [ "$RALPH_NETWORK_POLICY" = "on" ]; then
    proxy_up
    args+=(--network "$RALPH_INTERNAL_NET")
    args+=(-e "http_proxy=http://proxy:8888"  -e "HTTP_PROXY=http://proxy:8888")
    args+=(-e "https_proxy=http://proxy:8888" -e "HTTPS_PROXY=http://proxy:8888")
    args+=(-e "no_proxy=localhost,127.0.0.1"  -e "NO_PROXY=localhost,127.0.0.1")
  else
    warn "network policy is OFF -- the sandbox has unrestricted internet access"
    args+=(--network bridge)
  fi

  # --- blast-radius limits ------------------------------------------------
  [ -n "$RALPH_PIDS_LIMIT" ] && args+=(--pids-limit "$RALPH_PIDS_LIMIT")
  [ -n "$RALPH_MEMORY" ]     && args+=(--memory "$RALPH_MEMORY")
  [ -n "$RALPH_CPUS" ]       && args+=(--cpus "$RALPH_CPUS")
  if [ "$RALPH_HARDEN" = "on" ]; then
    args+=(--cap-drop ALL --security-opt no-new-privileges)
  fi

  # --- optional host material --------------------------------------------
  if [ "$RALPH_MOUNT_GITCONFIG" = "1" ] && [ -f "$HOME/.gitconfig" ]; then
    args+=(-v "$HOME/.gitconfig:/home/sandboxuser/.gitconfig:ro")
  fi
  if [ "$RALPH_MOUNT_SSH" = "1" ] && [ -d "$HOME/.ssh" ]; then
    warn "mounting ~/.ssh -- the agent can use your keys"
    args+=(-v "$HOME/.ssh:/home/sandboxuser/.ssh:ro")
  fi

  local tty=(-i)
  [ -t 0 ] && [ -t 1 ] && tty=(-it)

  local extra=()
  [ -n "$RALPH_DOCKER_ARGS" ] && read -r -a extra <<<"$RALPH_DOCKER_ARGS"

  # Note: the host Docker socket is deliberately never mounted.
  local run=(docker run --rm "${tty[@]}"
    --hostname ralph
    "${args[@]}"
    -w /workspace
    -e TERM="${TERM:-xterm-256color}"
    -e ANTHROPIC_API_KEY="${ANTHROPIC_API_KEY:-}"
    -e ANTHROPIC_BASE_URL="${ANTHROPIC_BASE_URL:-}"
    -e OPENAI_API_KEY="${OPENAI_API_KEY:-}"
    -e RALPH_AGENT_CMD="$RALPH_AGENT_CMD"
    -e RALPH_PROJECT="$RALPH_WORKSPACE"
    -e RALPH_MODEL_ORCHESTRATOR="$RALPH_MODEL_ORCHESTRATOR"
    -e RALPH_PROVIDER="$RALPH_PROVIDER"
    -e RALPH_FALLBACK="$RALPH_FALLBACK"
    -e RALPH_CODEX_CMD="$RALPH_CODEX_CMD"
    -e RALPH_CODEX_MODEL="$RALPH_CODEX_MODEL"
    -e RALPH_CODEX_EFFORT="$RALPH_CODEX_EFFORT"
    -e RALPH_LIMIT_PATTERN="$RALPH_LIMIT_PATTERN"
    -e RALPH_LOOP_SLEEP="$RALPH_LOOP_SLEEP"
    -e RALPH_LOOP_STALL="$RALPH_LOOP_STALL"
    -e RALPH_LOOP_FAILS="$RALPH_LOOP_FAILS"
    -e RALPH_LOOP_REPEAT="$RALPH_LOOP_REPEAT"
    -e RALPH_LOOP_MAX_COST="$RALPH_LOOP_MAX_COST"
    ${extra[@]+"${extra[@]}"}
    "$RALPH_IMAGE" "${entry[@]}" "$@")

  # The loop is wrapped rather than exec'd, so the host survives the container
  # and can post the alert the sandbox left behind. Combined login also has to
  # return so it can start the second provider.
  if [ "${RALPH_ENTRY:-agent}" = "loop" ]; then
    local rc=0
    "${run[@]}" || rc=$?
    loop_notify "$rc"
    exit "$rc"
  elif [ "${RALPH_RETURN_AFTER_RUN:-0}" = "1" ]; then
    "${run[@]}"
    return
  fi
  exec "${run[@]}"
}

cmd_shell() { RALPH_ENTRY=shell cmd_run "$@"; }

# ---------------------------------------------------------------------------
# Login
# ---------------------------------------------------------------------------
# Both providers keep their credential under the sandbox's $HOME, which is a
# Docker volume, so a login survives every container after it and you do this
# once per provider. Doing it from the host is not enough and never was: the
# sandbox cannot see the host's ~/.claude or ~/.codex.
#
# The login flow goes through the same egress proxy as everything else, so
# auth.openai.com and platform.claude.com have to be on the allowlist for it to
# complete. They are, in the shipped policy.
# Probe the volume for the credential each provider actually writes, rather
# than asking the CLIs. Their status subcommands come and go between releases;
# the file on disk is what makes the difference between a run that starts and
# one that dies on its first call.
login_status() {
  local provider="$1" probe
  # Single-quoted on purpose: these expand inside the container, where the
  # paths exist, not on the host, where they do not.
  # shellcheck disable=SC2016
  case "$provider" in
    codex) probe='test -s "${CODEX_HOME:-$HOME/.codex}/auth.json"' ;;
    *)     probe='test -s "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/.credentials.json"' ;;
  esac
  if docker run --rm -v "$RALPH_HOME_VOLUME:/home/sandboxuser" \
       --entrypoint bash "$RALPH_IMAGE" -lc "$probe" >/dev/null 2>&1; then
    printf 'logged in (credential in %s)\n' "$RALPH_HOME_VOLUME"
  else
    case "$provider" in
      codex) [ -n "${OPENAI_API_KEY:-}" ] \
               && printf 'no stored login; OPENAI_API_KEY is set on the host and will be passed in\n' \
               || printf 'not logged in  (ralph login codex)\n' ;;
      *)     [ -n "${ANTHROPIC_API_KEY:-}" ] \
               && printf 'no stored login; ANTHROPIC_API_KEY is set on the host and will be passed in\n' \
               || printf 'not logged in  (ralph login anthropic)\n' ;;
    esac
  fi
}

cmd_login() {
  local provider="${1:-$RALPH_PROVIDER}"

  image_exists "$RALPH_IMAGE" || { info "no image yet, building (one time)"; cmd_build; }
  volume_exists "$RALPH_HOME_VOLUME" || docker volume create "$RALPH_HOME_VOLUME" >/dev/null

  case "$provider" in
    status)
      printf 'home volume   %s\n\n' "$RALPH_HOME_VOLUME"
      printf 'anthropic:\n'; login_status anthropic | sed 's/^/  /'
      printf 'codex:\n';     login_status codex     | sed 's/^/  /'
      return 0
      ;;
    both|all)
      RALPH_RETURN_AFTER_RUN=1 cmd_login anthropic
      RALPH_RETURN_AFTER_RUN=1 cmd_login codex
      return 0
      ;;
  esac
  provider="$(check_provider "$provider")"

  case "$provider" in
    codex)
      # --device-auth is the flow that works without a browser on the same
      # machine: codex prints a code, you open the URL wherever you like. The
      # plain OAuth flow wants to bind a localhost callback inside the
      # container, which no host browser can reach.
      if [ -n "${OPENAI_API_KEY:-}" ]; then
        info "logging codex in with OPENAI_API_KEY from the host environment"
        RALPH_ENTRY=login \
        RALPH_LOGIN_CMD='printenv OPENAI_API_KEY | codex login --with-api-key' \
          cmd_run
      else
        info "codex device login -- open the URL it prints and enter the code"
        RALPH_ENTRY=login RALPH_LOGIN_CMD='codex login --device-auth' cmd_run
      fi
      ;;
    *)
      info "starting the agent -- type /login, finish the flow, then /exit"
      RALPH_ENTRY=agent RALPH_PROVIDER=anthropic cmd_run
      ;;
  esac
}

# ---------------------------------------------------------------------------
# Clone-mode sync
# ---------------------------------------------------------------------------
cmd_diff() {
  [ "$RALPH_MODE" = "clone" ] || die "diff applies to clone mode (RALPH_MODE=clone)"
  local ws_volume; ws_volume="$(ws_volume_name)"
  volume_exists "$ws_volume" || die "no sandbox workspace yet for $RALPH_WORKSPACE"
  docker run --rm \
    -v "$RALPH_WORKSPACE:/run/sandbox/source:ro" -v "$ws_volume:/workspace" \
    --entrypoint diff "$RALPH_IMAGE" \
    -ru --exclude=.git --exclude=.ralph-seeded /run/sandbox/source /workspace || true
}

cmd_apply() {
  [ "$RALPH_MODE" = "clone" ] || die "apply applies to clone mode (RALPH_MODE=clone)"
  local ws_volume; ws_volume="$(ws_volume_name)"
  volume_exists "$ws_volume" || die "no sandbox workspace yet for $RALPH_WORKSPACE"
  snapshot_create
  warn "copying the sandbox workspace over $RALPH_WORKSPACE"
  printf 'Continue? [y/N] ' >&2
  read -r reply
  case "$reply" in [yY]*) ;; *) die "aborted" ;; esac
  docker run --rm \
    -v "$RALPH_WORKSPACE:/run/sandbox/target" -v "$ws_volume:/workspace:ro" \
    --entrypoint rsync "$RALPH_IMAGE" \
    -a --exclude=.git --exclude=.ralph-seeded /workspace/ /run/sandbox/target/
  info "applied. Review with: git status"
}

# ---------------------------------------------------------------------------
# Status / clean / help
# ---------------------------------------------------------------------------
cmd_status() {
  printf 'repo          %s\n' "$RALPH_ROOT"
  printf 'workspace     %s\n' "$RALPH_WORKSPACE"
  printf 'mode          %s' "$RALPH_MODE"
  case "$RALPH_MODE" in
    direct) printf '  (host files are live and writable)\n' ;;
    clone)  printf '  (host files read-only; agent works in a private copy)\n' ;;
    none)   printf '  (no host filesystem)\n' ;;
  esac
  printf 'agent         %s\n' "$(provider_agent_cmd "$RALPH_PROVIDER")"
  printf 'provider      %s' "$RALPH_PROVIDER"
  if [ "$RALPH_FALLBACK" = "off" ] || [ "$RALPH_FALLBACK" = "$RALPH_PROVIDER" ]; then
    printf '  (no fallback -- a limit or a wall halts the run)\n'
  else
    printf '  -> %s on a usage limit, repeated failure, or three strikes\n' "$RALPH_FALLBACK"
  fi
  printf 'orchestrator  %s\n' "$RALPH_MODEL_ORCHESTRATOR"
  printf 'codex         %s  %s effort  (one session, all four roles)\n' \
    "$RALPH_CODEX_MODEL" "$RALPH_CODEX_EFFORT"
  if [ -d "$RALPH_WORKSPACE/.claude/agents" ]; then
    printf 'subagents     %s\n' \
      "$(cmd_model ls | sed 1d | awk '$1 != "codex" { printf "%s=%s ", $1, $2 }')"
  else
    printf 'subagents     none  (ralph init)\n'
  fi
  if notify_configured; then
    printf 'notify        %s  (posted from the host when a run ends)\n' "$(notify_channels)"
  else
    printf 'notify        off  (set RALPH_SLACK_WEBHOOK, RALPH_DISCORD_WEBHOOK,\n'
    printf '                    or RALPH_TELEGRAM_TOKEN + RALPH_TELEGRAM_CHAT)\n'
  fi
  if [ "$RALPH_LOOP_MAX" = "0" ]; then
    printf 'loop          uncapped  (until the PRD is done or a guardrail trips)\n'
  else
    printf 'loop          capped at %s iteration(s)\n' "$RALPH_LOOP_MAX"
  fi
  if [ "$RALPH_NETWORK_POLICY" = "on" ]; then
    printf 'network       deny-by-default via proxy  (%s)\n' \
      "$(proxy_running && echo 'proxy up' || echo 'proxy will start on run')"
    printf 'policy        %s\n' "$RALPH_ALLOWLIST"
  else
    printf 'network       UNRESTRICTED\n'
  fi
  printf 'hardened      %s\n' "$RALPH_HARDEN"
  printf 'snapshots     %s  (%s)\n' "$RALPH_SNAPSHOT" "$(snapshot_store)"
  printf 'config        %s%s\n' "$RALPH_CONFIG" "$([ -f "$RALPH_CONFIG" ] || echo '  (none)')"
  if image_exists "$RALPH_IMAGE"; then
    printf 'image         %s  %s\n' "$RALPH_IMAGE" \
      "$(docker image inspect "$RALPH_IMAGE" --format '{{.Architecture}}' 2>/dev/null)"
  else
    printf 'image         %s  (not built, run: ralph build)\n' "$RALPH_IMAGE"
  fi
  if volume_exists "$RALPH_HOME_VOLUME" && image_exists "$RALPH_IMAGE"; then
    printf 'home volume   %s  (holds the sandbox logins)\n' "$RALPH_HOME_VOLUME"
    printf 'login         anthropic: %s\n' "$(login_status anthropic)"
    printf 'login         codex:     %s\n' "$(login_status codex)"
  else
    printf 'home volume   %s  (not created -- ralph login)\n' "$RALPH_HOME_VOLUME"
  fi
}

cmd_clean() {
  case "${1:-}" in
    volume)
      volume_exists "$RALPH_HOME_VOLUME" || { info "no home volume"; return 0; }
      warn "removing $RALPH_HOME_VOLUME -- this signs the sandbox out"
      docker volume rm "$RALPH_HOME_VOLUME"
      ;;
    workspace)
      local ws_volume; ws_volume="$(ws_volume_name)"
      if volume_exists "$ws_volume"; then docker volume rm "$ws_volume"
      else info "no sandbox workspace volume for $RALPH_WORKSPACE"; fi
      ;;
    image)
      if image_exists "$RALPH_IMAGE"; then docker image rm "$RALPH_IMAGE"; else info "no image"; fi
      if image_exists "$RALPH_PROXY_IMAGE"; then docker image rm "$RALPH_PROXY_IMAGE"; fi
      ;;
    proxy)
      proxy_down
      docker network rm "$RALPH_INTERNAL_NET" "$RALPH_EGRESS_NET" >/dev/null 2>&1 || true
      ;;
    all)
      cmd_clean proxy || true; cmd_clean image || true
      cmd_clean workspace || true; cmd_clean volume || true
      ;;
    *) die "usage: ralph clean <image|volume|workspace|proxy|all>" ;;
  esac
}

cmd_proxy() {
  case "${1:-status}" in
    up)     proxy_up; info "proxy up" ;;
    down)   proxy_down ;;
    logs)   docker logs -f "$RALPH_PROXY_NAME" ;;
    status) proxy_running && echo "proxy: running" || echo "proxy: stopped" ;;
    *) die "usage: ralph proxy <up|down|logs|status>" ;;
  esac
}

# ---------------------------------------------------------------------------
# The Ralph loop
# ---------------------------------------------------------------------------
# `init` lays down the PRD, the loop prompt, the shared state files and the
# orchestrator's three subagents. It runs on the host, not in the sandbox, so
# you can open PRD.md in your editor before anything starts.
cmd_init() {
  case "${1:-}" in
    ''|--force) : ;;
    *) die "unknown argument: $1 (expected --force)" ;;
  esac
  local force=0
  [ "${1:-}" = "--force" ] && force=1

  local src="$RALPH_ROOT/templates"
  [ -d "$src" ] || die "templates not found at $src"
  [ -d "$RALPH_WORKSPACE" ] || die "workspace not a directory: $RALPH_WORKSPACE"

  local rel dest created=0 skipped=0
  while IFS= read -r rel; do
    [ -n "$rel" ] || continue
    dest="$RALPH_WORKSPACE/$rel"
    if [ -e "$dest" ] && [ "$force" -eq 0 ]; then
      printf '  skip    %s\n' "$rel"
      skipped=$((skipped + 1))
      continue
    fi
    mkdir -p "$(dirname "$dest")"
    cp "$src/$rel" "$dest"
    printf '  create  %s\n' "$rel"
    created=$((created + 1))
  done <<EOF
$(cd "$src" && find . -type f | sed 's|^\./||' | sort)
EOF

  info "$created file(s) created, $skipped left alone"
  if [ "$skipped" -gt 0 ] && [ "$force" -eq 0 ]; then
    info "'ralph init --force' would overwrite them"
  fi
  cat <<'__NEXT__'

Next:
  1. Fill in PRD.md -- what you are building, and how a machine can tell when
     it is done. That file is the loop's entire definition of success.
  2. ralph loop

__NEXT__
}

# `loop` is `run` with a different entrypoint: the agent is driven by
# ralph-loop inside the sandbox instead of being handed a terminal. One
# container and one snapshot for the whole run, not one per iteration.
cmd_loop() {
  take_provider_flag "$@"
  set -- ${RALPH_ARGV[@]+"${RALPH_ARGV[@]}"}

  local n="$RALPH_LOOP_MAX"
  if [ $# -gt 0 ]; then
    case "$1" in
      ''|*[!0-9]*) : ;;
      *) n="$1"; shift ;;
    esac
  fi

  case "$RALPH_MODE" in
    direct|clone)
      [ -f "$RALPH_WORKSPACE/.ralph/PROMPT.md" ] ||
        die "no .ralph/PROMPT.md in $RALPH_WORKSPACE -- run 'ralph init' first"
      [ -f "$RALPH_WORKSPACE/PRD.md" ] ||
        warn "no PRD.md -- the loop has no definition of done to work towards"
      # Codex runs a different prompt, because it plays all four roles itself.
      # A workspace scaffolded before codex support has only the four-role one,
      # and the handover would fail halfway through an unattended night.
      if [ "$RALPH_PROVIDER" = "codex" ] || [ "$RALPH_FALLBACK" = "codex" ]; then
        [ -f "$RALPH_WORKSPACE/.ralph/PROMPT.codex.md" ] || {
          if [ "$RALPH_PROVIDER" = "codex" ]; then
            die "no .ralph/PROMPT.codex.md in $RALPH_WORKSPACE -- run 'ralph init' to add it"
          fi
          warn "no .ralph/PROMPT.codex.md -- the codex fallback cannot take over; run 'ralph init'"
        }
      fi
      ;;
  esac

  if [ "$RALPH_PROVIDER" = "codex" ] || [ "$RALPH_FALLBACK" = "codex" ]; then
    warn_codex_egress
  fi

  if [ "$n" = "0" ]; then
    info "looping until the PRD is done, mode=$RALPH_MODE, provider=$RALPH_PROVIDER"
    info "guardrails: $RALPH_LOOP_REPEAT repeats, $RALPH_LOOP_STALL idle, ${RALPH_LOOP_MAX_COST:-no} spend ceiling"
  else
    info "looping up to $n iteration(s), mode=$RALPH_MODE, provider=$RALPH_PROVIDER"
  fi
  RALPH_ENTRY=loop cmd_run "$n" "$@"
}

# Read one file out of the agent's workspace, wherever that workspace lives.
read_workspace_file() {
  local rel="$1" ws_volume
  case "$RALPH_MODE" in
    direct)
      [ -f "$RALPH_WORKSPACE/$rel" ] || return 1
      cat "$RALPH_WORKSPACE/$rel"
      ;;
    *)
      ws_volume="$(ws_volume_name)"
      volume_exists "$ws_volume" || return 1
      docker run --rm -v "$ws_volume:/workspace:ro" \
        --entrypoint cat "$RALPH_IMAGE" "/workspace/$rel" 2>/dev/null
      ;;
  esac
}

notify_configured() {
  [ -n "$RALPH_SLACK_WEBHOOK" ] && return 0
  [ -n "$RALPH_DISCORD_WEBHOOK" ] && return 0
  [ -n "$RALPH_TELEGRAM_TOKEN" ] && [ -n "$RALPH_TELEGRAM_CHAT" ] && return 0
  return 1
}

notify_channels() {
  local names=""
  [ -n "$RALPH_SLACK_WEBHOOK" ] && names="$names slack"
  [ -n "$RALPH_DISCORD_WEBHOOK" ] && names="$names discord"
  [ -n "$RALPH_TELEGRAM_TOKEN" ] && [ -n "$RALPH_TELEGRAM_CHAT" ] && names="$names telegram"
  printf '%s' "${names# }"
}

# Escape a string for embedding in a JSON value. jq is not guaranteed on the
# host, and this only ever handles text ralph itself wrote.
json_string() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g' | awk '{ printf "%s\\n", $0 }'
}

notify_post() {
  if curl -fsS -m 15 -X POST -H 'Content-type: application/json' \
       --data "$2" "$1" >/dev/null 2>&1; then
    info "notified $3"
  else
    warn "could not notify $3"
  fi
}

# One notification per run, not per iteration, describing how the loop ended.
loop_notify() {
  local rc="$1" text escaped
  notify_configured || return 0
  if [ "$RALPH_NOTIFY_ON" = "problem" ] && [ "$rc" -eq 0 ]; then
    return 0
  fi
  if ! command -v curl >/dev/null 2>&1; then
    warn "curl not found on the host, so no notification was sent"
    return 0
  fi

  text="$(read_workspace_file .ralph/alert.txt 2>/dev/null || true)"
  [ -n "$text" ] || text="ralph loop: exited $rc without writing an alert
$RALPH_WORKSPACE"

  if [ -n "$RALPH_SLACK_WEBHOOK" ]; then
    escaped="$(json_string "$text")"
    notify_post "$RALPH_SLACK_WEBHOOK" "$(printf '{"text":"%s"}' "$escaped")" slack
  fi
  if [ -n "$RALPH_DISCORD_WEBHOOK" ]; then
    # Discord rejects anything over 2000 characters outright.
    escaped="$(json_string "$(printf '%s' "$text" | head -c 1800)")"
    notify_post "$RALPH_DISCORD_WEBHOOK" "$(printf '{"content":"%s"}' "$escaped")" discord
  fi
  if [ -n "$RALPH_TELEGRAM_TOKEN" ] && [ -n "$RALPH_TELEGRAM_CHAT" ]; then
    escaped="$(json_string "$(printf '%s' "$text" | head -c 4000)")"
    notify_post "$RALPH_TELEGRAM_API/bot$RALPH_TELEGRAM_TOKEN/sendMessage" \
      "$(printf '{"chat_id":"%s","text":"%s"}' "$RALPH_TELEGRAM_CHAT" "$escaped")" telegram
  fi
  return 0
}

# Which model each role in the tree runs on. The orchestrator's is an env var
# because it is this script that launches it; the subagents' models are
# frontmatter in the project, which is also where you can read them.
cmd_model() {
  local dir="$RALPH_WORKSPACE/.claude/agents"
  case "${1:-ls}" in
    ls)
      printf '%-14s %-10s %s\n' orchestrator "$RALPH_MODEL_ORCHESTRATOR" '(RALPH_MODEL_ORCHESTRATOR)'
      if [ ! -d "$dir" ]; then
        warn "no subagents in $RALPH_WORKSPACE -- run 'ralph init'"
        return 0
      fi
      local f name model
      for f in "$dir"/*.md; do
        [ -e "$f" ] || continue
        name="$(basename "$f" .md)"
        model="$(sed -n 's/^model:[[:space:]]*//p' "$f" | head -1)"
        printf '%-14s %-10s %s\n' "$name" "${model:-inherit}" ".claude/agents/$name.md"
      done
      # Codex gets one row, not four, because it gets one model: its subagents
      # all share a single default_subagent_model, so there is no per-role dial
      # to show. The prompt carries the role split instead.
      printf '%-14s %-10s %s\n' "codex" "$RALPH_CODEX_MODEL" \
        "(RALPH_CODEX_MODEL, ${RALPH_CODEX_EFFORT} effort -- all four roles)"
      ;;
    *)
      local role="$1" model="${2:-}" f
      [ -n "$model" ] || die "usage: ralph model <role> <haiku|sonnet|opus|inherit>"
      [ "$role" != "orchestrator" ] ||
        die "the orchestrator's model is RALPH_MODEL_ORCHESTRATOR, not a file (env, or $RALPH_CONFIG)"
      [ "$role" != "codex" ] ||
        die "codex's model is RALPH_CODEX_MODEL, not a file (env, or $RALPH_CONFIG)"
      case "$model" in
        haiku|sonnet|opus|inherit|claude-*) ;;
        # .claude/agents/*.md is read by Claude Code, which cannot run an
        # OpenAI model. Writing one there fails at the far end of a long
        # unattended run, which is the worst place to find out.
        gpt-*|o[0-9]*) die "'$model' is an OpenAI model; set RALPH_CODEX_MODEL instead -- .claude/agents/$role.md is read by Claude Code" ;;
        *) die "unexpected model '$model' (expected haiku, sonnet, opus, inherit, or a claude-* id)" ;;
      esac
      f="$dir/$role.md"
      [ -f "$f" ] || die "no subagent '$role' in $dir"
      grep -q '^model:' "$f" || die "$f has no 'model:' line to change"
      sed "s/^model:.*/model: $model/" "$f" > "$f.ralph-tmp" && mv "$f.ralph-tmp" "$f"
      info "$role now runs on $model"
      ;;
  esac
}

cmd_help() {
  cat <<'__HELP__'
ralph -- run a coding agent in yolo mode inside a locked-down container.

COMMANDS
  ralph [run] [args...]   Launch the agent over the current directory (default)
  ralph login [provider]  Sign the sandbox in to anthropic or codex (do this first)
  ralph init [--force]    Scaffold the Ralph loop: PRD, prompts, state, subagents
  ralph loop [N]          Run until the PRD is done (N caps the iterations)
  ralph model [role model]  Show, or change, the model behind each role
  ralph shell [args...]   Open a shell in the sandbox instead
  ralph status            Show mode, network policy, images and volumes
  ralph build [docker..]  Build the sandbox and proxy images
  ralph update            Rebuild from scratch with the latest agents

  ralph policy ls         Show the egress allowlist
  ralph policy edit       Edit it, then restart the proxy
  ralph policy sync       Add shipped rules yours is missing, keeping your own
  ralph policy test HOST  Check whether a host is reachable under the policy
  ralph policy reset      Restore the shipped defaults

  ralph snapshot ls       List host-side workspace snapshots
  ralph snapshot create   Take one now
  ralph snapshot restore [ID]   Roll the workspace back

  ralph diff              Clone mode: what the agent changed
  ralph apply             Clone mode: copy those changes onto the host

  ralph proxy <up|down|logs|status>
  ralph clean <image|volume|workspace|proxy|all>

FIRST RUN
  ralph login anthropic   then type /login inside the agent
  ralph login codex       device-code flow; open the URL it prints
  ralph login status      what the sandbox is currently signed in to

  Logins persist in a Docker volume, so you only do this once per provider.
  Sign in to both if you want the codex fallback to be able to take over.

PROVIDERS
  Anthropic drives the loop by default, as four agents on four models.
  Codex catches it -- on a usage limit, on repeated failure, or when three
  attempts on one failure are spent -- and runs ONE session playing all four
  roles, because Codex has no per-role subagent definitions. The handover is
  one-way, and the incoming provider gets its own three attempts, not more.

  ralph loop --provider codex    start on codex instead
  RALPH_FALLBACK=off ralph loop  no handover; a wall halts the run

THE LOOP
  ralph init              then edit PRD.md
  ralph loop              one task per iteration until the PRD is done. No
                          iteration cap -- it stops on the completion signal,
                          on 3 repeats of one failure, on 3 idle iterations,
                          on repeated agent failure, or on a spend ceiling.
  ralph loop 10           same, but stop after 10 iterations regardless

  Ideas the loop finds but does not build land in PROPOSALS.md for you to
  promote into PRD.md later.

  Notifications, posted from the host when a run ends:
  RALPH_SLACK_WEBHOOK  RALPH_DISCORD_WEBHOOK  RALPH_TELEGRAM_TOKEN + _CHAT

  Models per role:
  ralph model developer sonnet   (cheap MVP)
  ralph model developer opus     (escalate when the logic gets intricate)
  RALPH_CODEX_MODEL=gpt-5.6-terra  (a cheaper seat for the codex fallback)

KEY SETTINGS  (env vars, or ~/.config/ralph/config.env)
  RALPH_MODE              direct | clone | none        [direct]
  RALPH_NETWORK_POLICY    on | off                     [on]
  RALPH_HARDEN            on | off (drops caps, breaks sudo)  [off]
  RALPH_SNAPSHOT          on | off                     [on]
  RALPH_AGENT_CMD         command run inside           [claude --dangerously-skip-permissions]
  RALPH_LOOP_MAX          iteration cap, 0 = uncapped  [0]
  RALPH_LOOP_MAX_COST     stop past this spend in USD  [none]
  RALPH_LOOP_STALL        stop after N idle iterations [3]
  RALPH_LOOP_FAILS        stop after N agent failures  [2]
  RALPH_LOOP_REPEAT       stop after N repeats of one failure  [3]
  RALPH_MODEL_ORCHESTRATOR  model behind the orchestrator  [haiku]
  RALPH_PROVIDER          anthropic | codex            [anthropic]
  RALPH_FALLBACK          codex | off                  [codex]
  RALPH_CODEX_MODEL       one model for all four roles [gpt-5.6-sol]
  RALPH_CODEX_EFFORT      low|medium|high|xhigh|max    [high]
  RALPH_SLACK_WEBHOOK RALPH_DISCORD_WEBHOOK RALPH_TELEGRAM_TOKEN/_CHAT
  RALPH_NOTIFY_ON         always | problem             [always]
  RALPH_MEMORY RALPH_CPUS RALPH_PIDS_LIMIT
  RALPH_MOUNT_GITCONFIG   [1]      RALPH_MOUNT_SSH     [0]

Run `ralph status` to see what is actually in effect.
__HELP__
}

case "${1:-run}" in
  run)      shift || true
            take_provider_flag "$@"
            cmd_run ${RALPH_ARGV[@]+"${RALPH_ARGV[@]}"} ;;
  init)     shift; cmd_init "$@" ;;
  loop)     shift; cmd_loop "$@" ;;
  login)    shift; cmd_login "$@" ;;
  model)    shift; cmd_model "$@" ;;
  shell)    shift; cmd_shell "$@" ;;
  build)    shift; cmd_build "$@" ;;
  update)   shift; cmd_update "$@" ;;
  status)   shift; cmd_status "$@" ;;
  policy)   shift; cmd_policy "$@" ;;
  snapshot) shift; cmd_snapshot "$@" ;;
  proxy)    shift; cmd_proxy "$@" ;;
  diff)     shift; cmd_diff "$@" ;;
  apply)    shift; cmd_apply "$@" ;;
  clean)    shift; cmd_clean "$@" ;;
  help|-h|--help) cmd_help ;;
  *)        take_provider_flag "$@"
            cmd_run ${RALPH_ARGV[@]+"${RALPH_ARGV[@]}"} ;;
esac
