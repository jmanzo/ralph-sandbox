# ralph settings for this project, read on the host before the sandbox starts.
# Written by `ralph init --preset shopify`; commit it, so every checkout and
# every machine runs the loop the same way.
#
# Only the settings below may come from a project file -- the egress policy,
# the workspace mode and docker arguments belong to whoever runs `ralph`. See
# docs/configuration.md.

# The sandbox is Linux; your machine may not be. These directories hold
# binaries compiled for one of them -- the Prisma query engine, esbuild,
# rollup, lightningcss -- so each side keeps its own copy instead of
# overwriting the other's. The glob covers every extension that has its own
# package.json.
RALPH_ISOLATE="node_modules extensions/*/node_modules"

# Live credentials the loop has no use for, because the tests mock every
# service they belong to. These read as empty files inside the sandbox while
# your copies stay as they are. Add any other file that holds real keys.
RALPH_MASK=".env .env.local"
